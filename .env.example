# Copy to .env; set your own database credentials and a 64-character random hex key.
DATABASE_URL=mysql://ruoyi:CHANGE_ME@127.0.0.1:3306/ruoyi_rust_by
APP_KEY=
BIND_ADDR=127.0.0.1:8000
APP_URL=http://127.0.0.1:8000
CAPTCHA_ENABLED=true
TOKEN_MINUTES=120
# Only used by `ruoyi-rust-by init`; remove from .env after initialization.
ADMIN_INITIAL_PASSWORD=
RUST_LOG=ruoyi_rust_by=info,tower_http=warn

# Optional Redis monitor; only this namespace can be listed/read/deleted.
REDIS_URL=
REDIS_CACHE_PREFIX=ruoyi:cache:
# Embedded UTC scheduler; run migrate before starting an upgraded server.
SCHEDULER_ENABLED=true
